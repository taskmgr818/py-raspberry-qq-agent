[Unit]
Description=NapCat

[Container]
Image=docker.io/mlikiowa/napcat-docker:latest
Network=message-gateway.network
NetworkAlias=napcat
Environment=NAPCAT_UID=1000
Environment=NAPCAT_GID=1000
EnvironmentFile=%h/napcat/.env.napcat
PublishPort=127.0.0.1:6099:6099
Volume=%h/napcat/config:/app/napcat/config:Z
Volume=%h/napcat/QQ:/app/.config/QQ:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
