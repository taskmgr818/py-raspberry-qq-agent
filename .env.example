# Model endpoints and model names are configured in config.yaml.
LLM_API_KEY=
CLASSIFIER_API_KEY=

# Must match the OneBot 11 WebSocket server token in NapCat.
NAPCAT_ACCESS_TOKEN=

# Shared outbound queue. The API key must match message-gateway's configuration.
MESSAGE_GATEWAY_ENABLED=false
MESSAGE_GATEWAY_URL=http://127.0.0.1:8081
MESSAGE_GATEWAY_API_KEY=
MESSAGE_GATEWAY_ACCOUNT=qq

# Optional MCP bridge upload endpoint.
MCP_ENABLED=false
MCP_UPLOAD_ENDPOINT=
MCP_UPLOAD_API_TOKEN=

# Optional logging format override.
LOG_JSON=false

# Keycloak member directory (guild also enables it).
KEYCLOAK_ENABLED=false
OIDC_ISSUER=
KEYCLOAK_ADMIN_URL=
BOT_KEYCLOAK_CLIENT_ID=
BOT_KEYCLOAK_CLIENT_SECRET=

# Guild integration (disabled by default in YAML).
GUILD_DATABASE_URL=
GUILD_PUBLIC_URL=
